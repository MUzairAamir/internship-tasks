          "text": [
            "type a line to calculate word count :how are you how you yoou are doing \n",
            "how are you how you yoou are doing \n",
            "{'how': 2, 'are': 2, 'you': 2, 'yoou': 1, 'doing': 1}\n"
          ]
        }
      ],
      "source": [
        "line = input(\"type a line to calculate word count :\")\n",
        "print(line)\n",
        "dist={}\n",
        "words=line.split()\n",
        "for word in words:\n",
        "    if word in dist:\n",
        "        dist[word]=dist[word]+1\n",
        "    else:\n",
        "        dist[word]=1\n",
        "print(dist)"
      ]
